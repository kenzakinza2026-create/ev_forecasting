{
    "id": null,
    "uid": "advqdrf",
    "title": "Evidently AI - Drift Monitoring (Global Summary)",
    "tags": [
        "evidently",
        "drift",
        "dcforecaster"
    ],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": {
        "from": "now-24h",
        "to": "now"
    },
    "templating": {
        "list": [
            {
                "name": "job",
                "type": "query",
                "datasource": {
                    "type": "prometheus",
                    "uid": "prometheus-ds"
                },
                "query": "label_values(dataset_drift, job)",
                "refresh": 2,
                "includeAll": true,
                "multi": true,
                "current": {
                    "text": "All",
                    "value": "$__all"
                }
            }
        ]
    },
    "panels": [
        {
            "id": 1,
            "type": "row",
            "title": "Global Results - Data Drift",
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 24,
                "h": 1
            },
            "collapsed": false,
            "panels": []
        },
        {
            "id": 2,
            "type": "stat",
            "title": "dataset_drift (global)",
            "gridPos": {
                "x": 0,
                "y": 1,
                "w": 8,
                "h": 6
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus-ds"
            },
            "targets": [
                {
                    "expr": "dataset_drift{job=~\"$job\"}",
                    "refId": "A",
                    "instant": true,
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus-ds"
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "bool",
                    "decimals": 0,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "blue",
                                "value": null
                            }
                        ]
                    },
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": {
                                    "text": "No drift"
                                },
                                "1": {
                                    "text": "Drift detected"
                                }
                            }
                        }
                    ]
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto"
            }
        },
        {
            "id": 3,
            "type": "gauge",
            "title": "drift_share",
