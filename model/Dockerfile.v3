FROM python:3.12-slim

WORKDIR /app

COPY requirements-v3.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --default-timeout=300 --retries 10 -r requirements-v3.txt

# Code v3 : track.py, pipeline/ (dont serving.py) et new_models_dc/
# Le dossier data/ est monte en volume (voir docker-compose.yml)
COPY . .

CMD ["python", "track.py", "--help"]
